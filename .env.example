# RESEND CONFIGURATION
# Obtén tu API Key desde el panel de control de Resend: https://resend.com/api-keys
RESEND_API_KEY=re_tu_api_key_aqui

# Dirección de correo electrónico donde recibirás los mensajes del formulario
CONTACT_RECEIVER_EMAIL=dralfonsoaponte@gmail.com

# Dirección de correo electrónico remitente autorizada en Resend.
# Por defecto, puedes usar 'onboarding@resend.dev' para enviar correos a tu dirección registrada.
# Una vez verificado tu dominio propio, puedes cambiarlo por algo como 'contacto@tu-dominio.com'.
CONTACT_SENDER_EMAIL=onboarding@resend.dev

# FUNNEL DE CERTIFICACIÓN (/certificaciones)
# URL /exec de la aplicación web de Google Apps Script (ver apps-script/leads.gs)
SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/XXXX/exec
# Clave compartida con la propiedad WEBHOOK_SECRET del Apps Script
SHEETS_WEBHOOK_SECRET=una_clave_larga_y_secreta
# Google Calendar → Agenda de citas → Compartir → Insertar en el sitio web → URL del iframe
NEXT_PUBLIC_BOOKING_URL=https://calendar.google.com/calendar/appointments/schedules/XXXX?gv=true
